<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lk.cm1601.malabe_spare_system.controller.PosController">

    <children>

        <Label layoutX="250" layoutY="20"
               text="Point Of Sale"
               style="-fx-font-size:24px; -fx-font-weight:bold;"/>

        <TableView fx:id="tableInventory"
                   layoutX="20"
                   layoutY="70"
                   prefWidth="760"
                   prefHeight="220">

            <columns>

                <TableColumn fx:id="colCode" text="Code" prefWidth="90"/>

                <TableColumn fx:id="colName" text="Name" prefWidth="170"/>

                <TableColumn fx:id="colPrice" text="Price" prefWidth="100"/>

                <TableColumn fx:id="colQuantity" text="Stock" prefWidth="100"/>

                <TableColumn fx:id="colCategory" text="Category" prefWidth="140"/>

            </columns>

        </TableView>

        <Label layoutX="20" layoutY="320" text="Quantity"/>

        <TextField fx:id="txtQuantity"
                   layoutX="90"
                   layoutY="315"
                   prefWidth="120"/>

        <Button fx:id="btnAddCart"
                layoutX="240"
                layoutY="315"
                prefWidth="120"
                text="Add To Cart"
                onAction="#handleAddToCart"/>

        <Button fx:id="btnCheckout"
                layoutX="390"
                layoutY="315"
                prefWidth="120"
                text="Checkout"
                onAction="#handleCheckout"/>

        <Label layoutX="20"
               layoutY="380"
               text="Cart Total :"/>

        <Label fx:id="lblTotal"
               layoutX="100"
               layoutY="380"
               text="0.00"
               style="-fx-font-size:18px; -fx-font-weight:bold;"/>

    </children>

</AnchorPane>